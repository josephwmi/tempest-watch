{
  "configVersion": "v3",
  "app": {
    "appId": 1137328,
    "appName": "Tempest",
    "appType": "app",
    "version": {
      "code": 14,
      "name": "2.1.0"
    },
    "icon": "icon-256.png",
    "vender": "tempest-watch",
    "description": "Live conditions from your Tempest personal weather station"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    },
    "type": 2
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Tempest"
    }
  },
  "defaultLanguage": "en-US"
}
