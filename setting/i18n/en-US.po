msgid "title"
msgstr "Tempest weather station"

msgid "intro"
msgstr "Enter the station ID and a personal access token for your own Tempest. Both are required. The watch app shows temperature, humidity, wind, pressure and rain straight from your backyard."

msgid "stationId"
msgstr "Station ID"

msgid "token"
msgstr "Personal access token (required)"

msgid "whereToFind"
msgstr "Find the ID at tempestwx.com > Settings > Stations. Create the token at tempestwx.com > Settings > Data Authorizations > Create Token. Tempest refuses every request without a token."

msgid "units"
msgstr "Units"

msgid "unitsImperial"
msgstr "Imperial (F, mph, inHg, in)"

msgid "unitsMetric"
msgstr "Metric (C, m/s, hPa, mm)"

msgid "savedStation"
msgstr "Saved. Station ID:"

msgid "notSetYet"
msgstr "No station saved yet."

msgid "test"
msgstr "Test connection"

msgid "testing"
msgstr "Checking with Tempest..."

msgid "enterIdFirst"
msgstr "Enter a station ID first."

msgid "enterTokenFirst"
msgstr "Enter your personal access token first. Tempest needs it for every request."

msgid "tokenMissing"
msgstr "(access token still missing)"

msgid "okPrefix"
msgstr "Connected:"

msgid "errAuth"
msgstr "Tempest rejected the token. Check it, or create a new one."

msgid "errNotFound"
msgstr "That station ID was not found. Check the digits."

msgid "errNoData"
msgstr "The station answered but has no reading yet. Is the Tempest online?"

msgid "errNetwork"
msgstr "Could not reach Tempest. Check the phone's connection."

msgid "howToRead"
msgstr "On the watch: the big number is the current temperature. Use < and > to see wind, air (humidity, dew point, pressure) and sun/rain. The middle button fetches again."

msgid "swipeHint"
msgstr "Pull down on the watch app to refresh, or open the app again."

msgid "errNoAnswer"
msgstr "No answer from the phone's side service. Make sure the watch is connected to the Zepp app, then tap Test again."

msgid "checkingOnWatch"
msgstr "Checking… now open Tempest on your watch. The result appears here within a few seconds."

msgid "checkingShort"
msgstr "Waiting for the watch…"
